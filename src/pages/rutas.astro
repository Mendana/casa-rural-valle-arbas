---
import { getLang, useTranslations } from "../i18n/utils";
import BasePageLayout from "../layouts/BasePageLayout.astro";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<BasePageLayout
  title={t("meta.book.title")}
  description={t("meta.book.description")}
>
  <section class="mx-auto max-w-600 px-4 py-12 md:px-8 md:py-16">
    <p class="font-sans text-sm text-muted uppercase tracking-[0.2em]">
      {t("routes.suptitle")}
    </p>
    <h1 class="font-serif text-5xl font-light text-ink mt-6 md:text-6xl">
      {t("routes.title.0")}
      <span class="text-wood italic">{t("routes.title.1")}</span>
    </h1>
    <p
      class="mt-2 font-serif text-xl text-ink font-light leading-8 md:text-2xl"
    >
      {t("routes.description")}
    </p>
  </section>
</BasePageLayout>
