---
import BasePageLayout from "../layouts/BasePageLayout.astro";
import BookingTermsPageContent from "../components/astro/BookingTermsPageContent.astro";
import BookingFooter from "../components/astro/BookingFooter.astro";
import { getLang, useTranslations } from "../i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<BasePageLayout
  title={t("meta.bookingTerms.title")}
  description={t("meta.bookingTerms.description")}
>
  <BookingTermsPageContent />
  <BookingFooter slot="footer" />
</BasePageLayout>
