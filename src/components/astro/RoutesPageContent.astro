---
import { getLang, useTranslations } from "../../i18n/utils";
import MountainRoutesSection from "./MountainRoutesSection.astro";
import AreaMapSection from "./AreaMapSection.astro";
import MoreActivitiesSection from "./MoreActivitiesSection.astro";
import RoutesCtaSection from "./RoutesCtaSection.astro";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<main>
  <section class="relative overflow-x-hidden mx-auto max-w-600 px-4 py-12 md:px-8 md:py-16">
    <div
      class="pointer-events-none absolute top-0 right-0 -z-10 hidden select-none md:block md:opacity-8"
    >
      <span
        class="font-serif text-9xl tracking-widest text-wood font-normal lg:text-[14em] lg:font-light lg:tracking-normal xl:text-[18em] 2xl:text-[24em]"
      >
        Arbas
      </span>
    </div>
    <p class="font-sans text-sm text-muted uppercase tracking-[0.2em]">
      {t("routes.suptitle")}
    </p>
    <h1 class="font-serif text-5xl font-light text-ink mt-6 md:text-6xl">
      {t("routes.title.0")}
      <span class="text-wood italic">{t("routes.title.1")}</span>
    </h1>
    <p
      class="mt-2 font-serif text-xl text-ink font-light leading-8 md:text-2xl"
    >
      {t("routes.description")}
    </p>
  </section>
  <MountainRoutesSection />
  <AreaMapSection />
  <MoreActivitiesSection />
  <RoutesCtaSection />
</main>
