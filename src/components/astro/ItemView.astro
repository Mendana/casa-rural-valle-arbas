---
interface Props {
  title: string;
  price: string;
  description: string;
}

const { title, price, description } = Astro.props;
---

<article class="flex flex-col gap-2 pt-4 border-t border-t-line/70">
  <div class="flex flex-row items-baseline justify-between gap-4">
    <h3 class="text-2xl font-light italic font-serif text-wood md:text-3xl">
      {title}
    </h3>
    <span class="text-sm uppercase tracking-widest text-line/70 md:text-base">{price}</span>
  </div>
  <p class="text-sm text-line/70 tracking-wide leading-7 md:text-base">
    {description}
  </p>
</article>
