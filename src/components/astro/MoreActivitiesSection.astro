---
import { getCollection } from "astro:content";
import { getLang, useTranslations } from "../../i18n/utils";
import MoreActivityCard from "./MoreActivityCard.astro";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const others = (await getCollection("activities"))
  .filter(
    (entry) => entry.id.startsWith(`${lang}/`) && entry.data.category === "other",
  )
  .sort((a, b) => a.data.order - b.data.order);

const labels = {
  distance: t("routes.field.distance"),
  duration: t("routes.field.duration"),
  elevationGain: t("routes.field.elevationGain"),
  travelTime: t("routes.field.travelTime"),
  difficulty: t("routes.field.difficulty"),
};
---

<section class="mx-auto max-w-600 px-4 py-12 md:px-8 md:py-16">
  <h2 class="font-serif text-4xl font-light text-ink md:text-5xl lg:text-6xl">
    {t("routes.moreSection.title")}
  </h2>
  <div class="mt-8 grid grid-cols-1 gap-12 md:grid-cols-2">
    {
      others.map((entry) => (
        <MoreActivityCard
          title={entry.data.title}
          type={entry.data.type}
          description={entry.data.description}
          image={entry.data.image}
          alt={entry.data.alt}
          distance={entry.data.distance}
          duration={entry.data.duration}
          elevationGain={entry.data.elevationGain}
          travelTime={entry.data.travelTime}
          difficulty={entry.data.difficulty}
          labels={labels}
        />
      ))
    }
  </div>
</section>
