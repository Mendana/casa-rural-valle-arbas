---
import { getLang, useTranslations } from "../../i18n/utils";
import { getCollection } from "astro:content";
import DetailSeasonView from "./DetailSeasonView.astro";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const entries = (await getCollection("seasons"))
  .filter((entry) => entry.id.startsWith(`${lang}/`))
  .sort((a, b) => a.data.order - b.data.order);
---

<section class="px-4 py-16 bg-bg2 border-y border-y-line md:px-8 lg:border-y-2">
  <div class="mx-auto max-w-600">
    <h3
      class="font-sans uppercase tracking-widest text-muted text-sm md:text-base"
    >
      {t("season.title")}
    </h3>
    <div class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
      {
        entries.map((entry) => (
          <DetailSeasonView
            title={entry.data.title}
            dates={entry.data.dates}
            description={entry.data.description}
          />
        ))
      }
    </div>
    <div></div>
  </div>
</section>
