<div
  aria-hidden="true"
  class="pointer-events-none fixed right-6 top-1/2 z-40 hidden -translate-y-1/2 lg:flex lg:flex-col lg:items-center lg:gap-3"
>
  <div class="relative h-32 w-px bg-line">
    <div
      id="rail-fill"
      class="absolute top-0 left-0 w-full bg-wood"
      style="height:0%"
    >
    </div>
    <div
      id="rail-dot"
      class="absolute -left-[3px] h-[7px] w-[7px] -translate-y-1/2 rounded-full bg-wood"
      style="top:0%"
    >
    </div>
  </div>
  <span
    id="rail-label"
    class="max-w-12 text-center font-sans text-[0.65rem] uppercase tracking-widest text-muted [writing-mode:vertical-rl]"
  ></span>
</div>
