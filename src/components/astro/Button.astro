---
interface Props {
  href: string;
  class?: string;
}

const { href, class: className = "" } = Astro.props;
---

<a
  href={href}
  class={`px-8 py-4 text-sm text-onwood uppercase tracking-widest bg-wood hover:bg-wood/90 hover:cursor-pointer hover:scale-105 focus-visible:bg-wood/90 focus-visible:scale-105 transition duration-300 md:text-base ${className}`}
>
  <slot />
</a>
