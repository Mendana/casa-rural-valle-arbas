---
interface Props {
  label: string;
  value: string;
}

const { label, value } = Astro.props;
---

<dl class="flex flex-col-reverse gap-2 pt-4 border-t border-t-line/70">
  <dt class="text-sm text-line/70 uppercase tracking-wider md:text-base">
    {label}
  </dt>
  <dd class="text-5xl font-serif font-light text-onwood lg:text-6xl xl:text-7xl">
    {value}
  </dd>
</dl>
