---
import { Font, getImage } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLang, getAlternatePath, useTranslations } from "../../i18n/utils";
import casaImg from "../../assets/images/casa-rural.jpg";

const { title, description } = Astro.props;

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const locales = { es: "es_ES", en: "en_US" } as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : null;

const ogImage = await getImage({ src: casaImg, width: 1200, height: 630, format: "jpg" });
const ogImageURL = Astro.site
  ? new URL(ogImage.src, Astro.site).toString()
  : ogImage.src;

const fullTitle = "Casa Rural - Valle de Arbas | " + title;

const esPath = getAlternatePath(lang, "es", Astro.url.pathname, import.meta.env.BASE_URL);
const enPath = getAlternatePath(lang, "en", Astro.url.pathname, import.meta.env.BASE_URL);
const esHref = getRelativeLocaleUrl("es", esPath);
const enHref = getRelativeLocaleUrl("en", enPath);
const esAlternateURL = Astro.site ? new URL(esHref, Astro.site).toString() : esHref;
const enAlternateURL = Astro.site ? new URL(enHref, Astro.site).toString() : enHref;

const siteURL = Astro.site ? new URL(`${base}/`, Astro.site).toString() : `${base}/`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LodgingBusiness",
      name: "Casa Rural Valle de Arbas",
      description,
      image: ogImageURL,
      url: canonicalURL,
      telephone: t("footer.contact.phone"),
      email: t("footer.contact.email"),
      address: {
        "@type": "PostalAddress",
        streetAddress: t("footer.location.street"),
        addressLocality: "Valle de Arbas",
        addressRegion: "León",
        addressCountry: "ES",
      },
      geo: {
        "@type": "GeoCoordinates",
        latitude: 42.928722,
        longitude: -5.80608,
      },
    },
    {
      "@type": "WebSite",
      name: "Casa Rural Valle de Arbas",
      url: siteURL,
      description: "Casa rural en el Valle de Arbas, León, España",
      inLanguage: lang === "es" ? "es-ES" : "en-US",
    },
  ],
};
---

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta http-equiv="X-UA-Compatible" content="IE=edge" />

	<!-- Redirige a /en/ en la primera visita si el navegador prefiere inglés -->
	<script is:inline define:vars={{ base: import.meta.env.BASE_URL }}>
		(function () {
			try {
				if (localStorage.getItem("lang")) return;
				var home = base.endsWith("/") ? base : base + "/";
				if (window.location.pathname !== home) return;
				var prefersEnglish = (navigator.language || "")
					.toLowerCase()
					.startsWith("en");
				if (prefersEnglish) {
					window.location.replace(home + "en/");
				}
			} catch (e) {}
		})();
	</script>

	<!-- Primary Meta Tags -->
	<title>{fullTitle}</title>
	<meta name="title" content={fullTitle} />
	<meta name="description" content={description} />
	<link rel="canonical" href={canonicalURL} />
	<link rel="alternate" hreflang="es" href={esAlternateURL} />
	<link rel="alternate" hreflang="en" href={enAlternateURL} />
	<link rel="alternate" hreflang="x-default" href={esAlternateURL} />

	<!--Aditional META TAGS -->
	<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
	<meta name="author" content="Casa Rural Valle de Arbas" />
	<meta name="language" content={lang === "es" ? "Spanish" : "English"} />
	<meta name="geo.region" content="ES-LE" />
	<meta name="geo.placename" content="Valle de Arbas, León, España" />
	<meta name="geo.position" content="42.928722;-5.806080" />

	<!-- Global Metadata -->
	<link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />
	<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
	<link rel="manifest" href={`${base}/manifest.webmanifest`} />
	<meta name="google" content="notranslate" />
	<meta name="theme-color" content="#f8f1e7" />

	<!-- Open Graph / Facebook -->
	<meta property="og:locale" content={locales[lang]} />
	<meta property="og:type" content="website" />
	<meta property="og:url" content={canonicalURL} />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:image" content={ogImageURL} />
	<meta property="og:image:alt" content={title} />
	<meta property="og:image:width" content="1200" />
	<meta property="og:image:height" content="630" />
	<meta property="og:site_name" content="Casa Rural Valle de Arbas" />

	<!-- Twitter -->
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />
	<meta name="twitter:image" content={ogImageURL} />
	<meta name="twitter:image:alt" content={title} />

	<link rel="sitemap" href={`${base}/sitemap-index.xml`} type="application/xml" />

	<Font cssVariable="--font-newsreader" preload />
	<Font cssVariable="--font-karla" preload />

	<!-- JSON-LD Schema -->
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

	<!-- Script de animaciones -->
	<script src="../../scripts/scroll-effects.ts"></script>
</head>
