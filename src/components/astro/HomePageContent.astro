---
import { getLang, useTranslations } from "../../i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";
import HomeHeroGallery from "./HomeHeroGallery.astro";
import SplitWords from "./SplitWords.astro";
import Button from "./Button.astro";
import FactsTicker from "./FactsTicker.astro";
import HomeMainInfoSection from "./HomeMainInfoSection.astro";
import HomeHighlights from "./HomeHighlights.astro";
import SeasonSection from "./SeasonSection.astro";
import HomeInteriorSection from "./HomeInteriorSection.astro";
import HomeCharacteristics from "./HomeCharacteristics.astro";
import PagesSection from "./PagesSection.astro";
import ScrollRail from "./ScrollRail.astro";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<main id="main-content">
  <ScrollRail />
  <section class="hero p-4 md:p-8 max-w-600 mx-auto">
    <HomeHeroGallery />
    <div class="mt-2 flex flex-col gap-2 text-center sm:mt-4 md:mt-8">
      <h1
        class="text-5xl font-light flex flex-col items-center justify-center gap-1 sm:text-6xl md:text-8xl"
      >
        <SplitWords text={t("index.mainTitle.1")} />
        <span class="text-wood italic">
          <SplitWords text={t("index.mainTitle.2")} />
        </span>
      </h1>
    </div>
    <div
      class="mt-8 flex flex-col gap-4 text-center md:mt-12 md:flex-row md:items-center md:justify-center md:gap-8"
    >
      <div class="flex justify-center">
        <Button href={getRelativeLocaleUrl(lang, t("path.book"))}>
          {t("index.bookNow")}
        </Button>
      </div>
      <p class="text-sm text-muted tracking-wider md:text-base">
        {t("index.bookNow.footer")}
      </p>
    </div>
  </section>
  <FactsTicker />
  <HomeMainInfoSection />
  <HomeHighlights />
  <SeasonSection />
  <HomeInteriorSection />
  <HomeCharacteristics />
  <PagesSection />
</main>
