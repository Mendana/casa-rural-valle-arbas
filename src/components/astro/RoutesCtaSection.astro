---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLang, useTranslations } from "../../i18n/utils";
import Button from "./Button.astro";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section data-reveal class="bg-bg2 px-4 py-16 md:px-8">
  <div
    class="mx-auto flex max-w-600 flex-col items-center gap-6 text-center md:flex-row md:justify-center md:gap-10"
  >
    <p class="font-serif text-3xl font-light text-ink md:text-4xl">
      {t("routes.cta.prefix")}{" "}
      <span class="text-wood italic">{t("routes.cta.highlight")}</span>?
    </p>
    <Button href={getRelativeLocaleUrl(lang, t("path.book"))}>
      {t("routes.cta.button")}
    </Button>
  </div>
</section>
