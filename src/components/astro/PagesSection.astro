---
import { getLang, useTranslations } from "../../i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "astro:assets";
import valleImg from "../../assets/images/valle-arbas.avif";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const CALENDAR_HIGHLIGHT_CELL = 16;
---

<section class="border-y border-line">
  <div class="mx-auto flex max-w-600 flex-col py-12 md:flex-row md:py-16">
    <article
      data-reveal
      class="relative flex-1 border-b border-b-line md:border-r md:border-b-0 border-r-line"
    >
      <div class="pointer-events-none absolute top-0 right-0 z-10 bg-wood px-2 py-1">
        <span class="font-sans text-sm uppercase tracking-widest text-onwood">
          {t("pagesSection.1.badge")}
        </span>
      </div>
      <a
        href={getRelativeLocaleUrl(lang, t("path.routes"))}
        class="group block p-6 transition-colors hover:bg-ink/5 focus-visible:bg-ink/5"
      >
        <div class="flex flex-col gap-2">
          <div class="overflow-hidden">
            <Image
              data-wipe
              src={valleImg}
              alt={t("pagesSection.1.alt")}
              width={860}
              height={559}
              loading="lazy"
              class="h-65 w-full object-cover transition duration-300 group-hover:scale-105 group-hover:brightness-75 group-focus-visible:scale-105 group-focus-visible:brightness-75"
            />
          </div>
          <h2
            class="mt-6 text-3xl font-serif font-light text-ink md:text-4xl lg:text-5xl"
          >
            {t("pagesSection.1.title")}
          </h2>
          <p
            class="text-base font-sans text-muted tracking-wide leading-6 md:text-lg"
          >
            {t("pagesSection.1.description")}
          </p>
          <span
            class="mt-4 inline-flex items-center gap-2 text-wood text-sm font-sans uppercase tracking-widest md:text-base"
          >
            {t("pagesSection.1.link")}
            <span
              class="transition-transform duration-300 group-hover:translate-x-1 group-focus-visible:translate-x-1"
            >
              →
            </span>
          </span>
        </div>
      </a>
    </article>
    <article data-reveal class="relative flex-1">
      <div class="pointer-events-none absolute top-0 right-0 z-10 bg-wood px-2 py-1">
        <span class="font-sans text-sm uppercase tracking-widest text-onwood">
          {t("pagesSection.2.badge")}
        </span>
      </div>
      <a
        href={getRelativeLocaleUrl(lang, t("path.book"))}
        class="group block p-6 transition-colors hover:bg-ink/5 focus-visible:bg-ink/5"
      >
        <div class="flex flex-col gap-2">
          <div class="overflow-hidden">
            <div
              data-wipe
              role="img"
              aria-label={t("pagesSection.2.alt")}
              class="flex h-65 w-full flex-col bg-bg2 p-6 transition duration-300 group-hover:scale-105 group-hover:brightness-75 group-focus-visible:scale-105 group-focus-visible:brightness-75"
            >
              <div class="flex items-center justify-between border-b border-line pb-3">
                <span class="font-serif text-lg italic text-ink">
                  {t("pagesSection.2.calendarMonth")}
                </span>
                <span
                  class="font-sans text-xs uppercase tracking-widest text-muted"
                >
                  {t("pagesSection.2.calendarYear")}
                </span>
              </div>
              <div class="mt-4 grid flex-1 grid-cols-7 gap-1.5">
                {
                  Array.from({ length: 35 }).map((_, i) => (
                    <span
                      class={`flex items-center justify-center font-sans text-[0.6rem] ${
                        i === CALENDAR_HIGHLIGHT_CELL
                          ? "bg-wood text-onwood"
                          : "bg-line/40 text-transparent"
                      }`}
                    >
                      {i === CALENDAR_HIGHLIGHT_CELL ? "24" : ""}
                    </span>
                  ))
                }
              </div>
            </div>
          </div>
          <h2
            class="mt-6 text-3xl font-serif font-light text-ink md:text-4xl lg:text-5xl"
          >
            {t("pagesSection.2.title")}
          </h2>
          <p
            class="text-base font-sans text-muted tracking-wide leading-6 md:text-lg"
          >
            {t("pagesSection.2.description")}
          </p>
          <span
            class="mt-4 inline-flex items-center gap-2 text-wood text-sm font-sans uppercase tracking-widest md:text-base"
          >
            {t("pagesSection.2.link")}
            <span
              class="transition-transform duration-300 group-hover:translate-x-1 group-focus-visible:translate-x-1"
            >
              →
            </span>
          </span>
        </div>
      </a>
    </article>
  </div>
</section>
