---
import { getCollection } from "astro:content";
import { getLang, useTranslations } from "../../i18n/utils";
import CharacteristicView from "./CharacteristicView.astro";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const characteristics = (await getCollection("characteristics")).filter(
  (entry) => entry.id.startsWith(`${lang}/`),
);
---

<section
  data-sec={t("characteristics.title")}
  class="relative z-0 overflow-hidden bg-ink px-4 py-16 md:py-24 md:px-8"
>
  <div
    data-par="0.045"
    class="pointer-events-none absolute -bottom-12 left-20 -z-10 hidden select-none lg:block lg:opacity-8 xl:-bottom-16"
    aria-hidden="true"
  >
    <span
      class="font-serif text-[10em] leading-none tracking-wider italic text-line font-light xl:text-[13em] 2xl:text-[16em]"
    >
      Arbas
    </span>
  </div>
  <h2
    class="font-sans text-xs font-semibold uppercase tracking-widest text-line/70 md:text-sm lg:text-base"
  >
    {t("characteristics.title")}
  </h2>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(150px,1fr))] gap-8 pt-8">
    {
      characteristics.map((entry) => (
        <CharacteristicView label={entry.data.label} value={entry.data.value} />
      ))
    }
  </div>
</section>
