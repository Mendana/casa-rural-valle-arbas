---
import { getCollection } from "astro:content";
import { getLang, useTranslations } from "../../i18n/utils";
import ReviewCard from "./ReviewCard.astro";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const reviews = (await getCollection("reviews"))
  .filter((entry) => entry.id.startsWith(`${lang}/`))
  .sort((a, b) => a.data.order - b.data.order);
---

{
  reviews.length > 0 && (
    <section
      data-sec={t("reviews.eyebrow")}
      class="relative z-0 overflow-hidden bg-ink px-4 py-16 md:py-24 md:px-8"
    >
      <div
        data-par="0.045"
        class="pointer-events-none absolute -top-10 right-4 -z-10 hidden select-none lg:block lg:opacity-8"
        aria-hidden="true"
      >
        <span class="font-serif text-[14em] leading-none text-line font-light xl:text-[18em] 2xl:text-[22em]">
          &rdquo;
        </span>
      </div>
      <div class="mx-auto max-w-600">
        <h2 class="font-sans text-xs font-semibold uppercase tracking-widest text-line/70 md:text-sm lg:text-base">
          {t("reviews.eyebrow")}
        </h2>
        <p class="mt-4 max-w-3xl font-serif text-3xl font-light leading-9 text-onwood md:text-4xl">
          {t("reviews.heading")}
        </p>
        <div class="mt-10 grid grid-cols-1 gap-8 md:grid-cols-3">
          {reviews.map((entry) => (
            <ReviewCard
              author={entry.data.author}
              origin={entry.data.origin}
              rating={entry.data.rating}
              text={entry.data.text}
            />
          ))}
        </div>
      </div>
    </section>
  )
}
