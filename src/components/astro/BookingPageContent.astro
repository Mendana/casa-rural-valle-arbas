---
import { getLang, useTranslations } from "../../i18n/utils";
import SplitWords from "./SplitWords.astro";
import BookingSimulator from "../react/BookingSimulator";
import ItemsSection from "./ItemsSection.astro";
import HowItWorksSection from "./HowItWorksSection.astro";
import ContactSection from "./ContactSection.astro";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<main id="main-content">
  <section class="relative overflow-x-clip mx-auto max-w-600 px-4 py-12 md:px-8 md:py-16">
    <div
      data-par="0.045"
      class="pointer-events-none absolute top-0 right-0 -z-10 hidden select-none md:block md:opacity-8"
      aria-hidden="true"
    >
      <span
        class="font-serif text-9xl tracking-widest text-wood font-normal lg:text-[14em] lg:font-light lg:tracking-normal xl:text-[18em] 2xl:text-[24em]"
      >
        {new Date().getFullYear()}
      </span>
    </div>
    <p class="font-sans text-sm text-muted uppercase tracking-[0.2em]">
      {t("book.suptitle")}
    </p>
    <h1 class="font-serif text-5xl font-light text-ink mt-6 md:text-6xl">
      <SplitWords text={t("book.title")} />
    </h1>
    <p
      class="mt-2 font-serif text-xl text-ink font-light leading-8 md:text-2xl"
    >
      {t("book.description")}
    </p>
    <div data-reveal class="mt-12">
      <BookingSimulator lang={lang} client:load />
    </div>
  </section>
  <ItemsSection />
  <HowItWorksSection />
  <ContactSection />
</main>
