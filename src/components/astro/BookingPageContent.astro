---
import { getLang, useTranslations } from "../../i18n/utils";
import SplitWords from "./SplitWords.astro";
import AvailabilityCalendar from "../react/AvailabilityCalendar";
import ItemsSection from "./ItemsSection.astro";
import HowItWorksSection from "./HowItWorksSection.astro";
import ContactSection from "./ContactSection.astro";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<main id="main-content">
  <section class="relative overflow-x-clip mx-auto max-w-600 px-4 py-12 md:px-8 md:py-16">
    <div
      data-par="0.045"
      class="pointer-events-none absolute top-0 right-0 -z-10 hidden select-none md:block md:opacity-8"
      aria-hidden="true"
    >
      <span
        class="font-serif text-9xl tracking-widest text-wood font-normal lg:text-[14em] lg:font-light lg:tracking-normal xl:text-[18em] 2xl:text-[24em]"
      >
        {new Date().getFullYear()}
      </span>
    </div>
    <p class="font-sans text-sm text-muted uppercase tracking-[0.2em]">
      {t("book.suptitle")}
    </p>
    <h1 class="font-serif text-5xl font-light text-ink mt-6 md:text-6xl">
      <SplitWords text={t("book.title")} />
    </h1>
    <p
      class="mt-2 font-serif text-xl text-ink font-light leading-8 md:text-2xl"
    >
      {t("book.description")}
    </p>
    <div
      data-reveal
      class="mt-12 flex flex-col gap-8 md:gap-12 lg:flex-row lg:items-start"
    >
      <div class="lg:flex-1">
        <AvailabilityCalendar lang={lang} client:load />
      </div>

      <div
        class="border border-line bg-bg2 px-6 py-8 md:px-10 md:py-12 lg:w-96 lg:shrink-0 xl:w-md 2xl:w-lg"
      >
        <p class="text-xs uppercase tracking-widest text-muted md:text-sm">
          {t("book.info.eyebrow")}
        </p>
        <h2 class="mt-2 font-serif text-2xl font-light text-ink md:text-3xl">
          {t("book.info.title")}
        </h2>

        <div
          class="mt-8 flex flex-col gap-3 border-t border-line pt-6 text-sm md:text-base"
        >
          <div class="flex items-center justify-between gap-4 text-ink">
            <span>{t("book.info.weekendLabel")}</span>
            <span>{t("book.info.weekendPrice")}</span>
          </div>
          <div class="flex items-center justify-between gap-4 text-ink">
            <span>{t("book.info.weekLabel")}</span>
            <span>{t("book.info.weekPrice")}</span>
          </div>
          <div class="flex items-center justify-between gap-4 text-ink">
            <span>{t("book.info.fortnightLabel")}</span>
            <span>{t("book.info.fortnightPrice")}</span>
          </div>
        </div>

        <p class="mt-6 text-sm text-muted">{t("book.info.otherOptions")}</p>

        <a
          href="#contacto"
          class="mt-8 inline-flex items-center gap-2 text-sm uppercase tracking-widest text-wood transition-colors hover:text-wood/95 focus-visible:text-wood/95 md:text-base"
        >
          {t("book.info.goToContact")}
          <span>→</span>
        </a>
      </div>
    </div>
  </section>
  <HowItWorksSection />
  <ItemsSection />
  <ContactSection />
</main>
