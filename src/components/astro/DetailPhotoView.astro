---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface HighlightImage {
  image: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  images: HighlightImage[];
  title: string;
  description: string;
  items?: string[];
  index: number;
  alignment: "left" | "right";
}

const { images, title, description, items, index, alignment } = Astro.props;
const orderLabel = String(index).padStart(2, "0");
const isRight = alignment === "right";
const hasMultiple = images.length > 1;
---

<article
  class:list={[
    "grid grid-cols-1 gap-6 pb-20 mb-20 last:pb-0 mt-8 lg:grid-cols-2 lg:items-center lg:gap-12",
    "not-last:border-b not-last:border-line",
  ]}
>
  <div
    data-row-photo={isRight ? "right" : "left"}
    class:list={["relative", isRight && "lg:order-2"]}
  >
    <div
      class="detail-carousel relative h-100 w-full overflow-hidden lg:h-150 xl:h-175 2xl:h-200"
    >
      <div class="detail-carousel-track flex h-full w-full transition-transform duration-500 ease-out">
        {
          images.map((img) => (
            <div class="relative h-full w-full shrink-0">
              <Image
                data-wipe
                src={img.image}
                alt={img.alt}
                width={860}
                height={640}
                class="h-full w-full object-cover"
              />
              {img.caption && (
                <div
                  class:list={[
                    "absolute -bottom-2 -left-2 border border-wood bg-bg px-3 py-1.5 lg:-bottom-4 lg:px-4 lg:py-2",
                    isRight && "lg:left-auto lg:-right-2",
                  ]}
                >
                  <span class="font-serif text-sm text-wood lg:text-base 2xl:text-lg">
                    {img.caption}
                  </span>
                </div>
              )}
            </div>
          ))
        }
      </div>

      {
        hasMultiple && (
          <>
            <button
              type="button"
              class="detail-carousel-prev absolute left-2 top-1/2 z-10 flex h-8 w-8 -translate-y-1/2 cursor-pointer items-center justify-center border border-line bg-bg text-ink transition-colors hover:border-wood hover:text-wood focus-visible:border-wood focus-visible:text-wood md:h-9 md:w-9"
              aria-label="Foto anterior"
            >
              ‹
            </button>
            <button
              type="button"
              class="detail-carousel-next absolute right-2 top-1/2 z-10 flex h-8 w-8 -translate-y-1/2 cursor-pointer items-center justify-center border border-line bg-bg text-ink transition-colors hover:border-wood hover:text-wood focus-visible:border-wood focus-visible:text-wood md:h-9 md:w-9"
              aria-label="Foto siguiente"
            >
              ›
            </button>
            <div class="pointer-events-none absolute inset-x-0 bottom-3 flex items-center justify-center">
              <div class="flex items-center gap-2 rounded-full bg-ink/50 px-2.5 py-1.5 backdrop-blur-sm">
                {images.map((_, i) => (
                  <button
                    type="button"
                    class="detail-carousel-dot pointer-events-auto h-1.5 w-1.5 cursor-pointer rounded-full bg-onwood/60 transition-all data-active:w-4 data-active:bg-onwood"
                    data-index={i}
                    aria-label={`Foto ${i + 1}`}
                  />
                ))}
              </div>
            </div>
          </>
        )
      }
    </div>
  </div>

  <div
    data-row-text={isRight ? "right" : "left"}
    class:list={[
      "relative md:max-w-125 lg:max-w-none",
      isRight && "md:order-1",
      isRight ? "xl:mr-24" : "xl:ml-24",
    ]}
  >
    <span
      data-par="0.045"
      class:list={[
        "pointer-events-none absolute -top-25 -z-10 hidden select-none font-serif font-light text-[10em] leading-none text-wood opacity-10 lg:block xl:text-[12em] 2xl:text-[16em]",
        isRight ? "lg:-right-2 lg:text-right" : "lg:right-2",
      ]}
      aria-hidden="true"
    >
      {orderLabel}
    </span>
    <span
      class="font-serif text-sm uppercase tracking-widest text-wood lg:text-base lg:max-w-150"
    >
      {orderLabel}
    </span>
    <h2
      class="mt-2 font-serif text-3xl text-ink font-light md:text-4xl lg:text-5xl lg:max-w-150 2xl:text-6xl"
    >
      {title}
    </h2>
    <p class="mt-3 text-lg text-muted lg:max-w-150">
      {description}
    </p>
    {
      items && items.length > 0 && (
        <ul class="mt-5 flex flex-col gap-2 border-t border-line pt-4 lg:max-w-150">
          {items.map((item) => (
            <li class="flex items-start gap-2 text-base text-muted">
              <span class="mt-1 text-wood" aria-hidden="true">
                –
              </span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<script>
  document.querySelectorAll<HTMLElement>(".detail-carousel").forEach((root) => {
    const track = root.querySelector<HTMLElement>(".detail-carousel-track");
    if (!track) return;

    const slides = Array.from(track.children) as HTMLElement[];
    const dots = Array.from(
      root.querySelectorAll<HTMLElement>(".detail-carousel-dot"),
    );
    const prevBtn = root.querySelector<HTMLButtonElement>(
      ".detail-carousel-prev",
    );
    const nextBtn = root.querySelector<HTMLButtonElement>(
      ".detail-carousel-next",
    );
    const count = slides.length;
    let active = 0;

    function render() {
      track!.style.transform = `translateX(-${active * 100}%)`;
      dots.forEach((dot, i) => {
        if (i === active) dot.setAttribute("data-active", "");
        else dot.removeAttribute("data-active");
      });
    }

    function goTo(index: number) {
      active = ((index % count) + count) % count;
      render();
    }

    dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));
    prevBtn?.addEventListener("click", () => goTo(active - 1));
    nextBtn?.addEventListener("click", () => goTo(active + 1));

    root.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") goTo(active - 1);
      if (e.key === "ArrowRight") goTo(active + 1);
    });

    let startX = 0;
    let dragging = false;
    root.addEventListener("pointerdown", (e) => {
      dragging = true;
      startX = e.clientX;
    });
    root.addEventListener("pointerup", (e) => {
      if (!dragging) return;
      dragging = false;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 40) goTo(active + (dx < 0 ? 1 : -1));
    });

    render();
  });
</script>
