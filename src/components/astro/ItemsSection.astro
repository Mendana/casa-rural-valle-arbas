---
import { getLang, useTranslations } from "../../i18n/utils";
import { getCollection } from "astro:content";
import ItemView from "./ItemView.astro";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const entries = (await getCollection("itemsInHouse")).filter((entry) =>
  entry.id.startsWith(`${lang}/`),
);
---

<section class="bg-ink px-4 py-12 md:px-8 md:py-16">
  <div class="mx-auto max-w-600">
    <h2
      class="font-sans text-xs font-semibold uppercase tracking-widest text-line/70 md:text-sm lg:text-base"
    >
      {t("book.itemsAvailable.title")}
    </h2>
    <div class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-2">
      {
        entries.map((entry) => (
          <ItemView
            title={entry.data.title}
            price={entry.data.price}
            description={entry.data.description}
          />
        ))
      }
      <a
        href="#contacto"
        data-reveal
        class="group flex flex-col gap-2 border-t border-t-line/70 pt-4 transition-colors hover:border-t-wood focus-visible:border-t-wood"
      >
        <div class="flex flex-row items-baseline justify-between gap-4">
          <h3 class="text-2xl font-light italic font-serif text-wood md:text-3xl">
            {t("book.itemsAvailable.contactTitle")}
          </h3>
          <span class="text-sm uppercase tracking-widest text-line/70 transition-colors group-hover:text-wood md:text-base">
            →
          </span>
        </div>
        <p class="text-sm text-line/70 tracking-wide leading-7 md:text-base">
          {t("book.itemsAvailable.contactNote")}
        </p>
      </a>
    </div>
  </div>
</section>
