---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  type: string;
  description: string;
  image?: ImageMetadata;
  alt?: string;
  distance?: string;
  duration?: string;
  elevationGain?: string;
  travelTime?: string;
  difficulty?: string;
  labels: {
    distance: string;
    duration: string;
    elevationGain: string;
    travelTime: string;
    difficulty: string;
  };
}

const {
  title,
  type,
  description,
  image,
  alt,
  distance,
  duration,
  elevationGain,
  travelTime,
  difficulty,
  labels,
} = Astro.props;

const meta = [
  distance && { label: labels.distance, value: distance },
  duration && { label: labels.duration, value: duration },
  elevationGain && { label: labels.elevationGain, value: elevationGain },
  travelTime && { label: labels.travelTime, value: travelTime },
  difficulty && { label: labels.difficulty, value: difficulty },
].filter(Boolean) as { label: string; value: string }[];
---

<details
  data-reveal
  class="border-t border-t-line py-4 [&_summary::-webkit-details-marker]:hidden"
>
  <summary class="group flex cursor-pointer list-none items-center justify-between gap-4">
    <div class="flex items-center gap-4">
      {
        image && (
          <Image
            src={image}
            alt={alt ?? title}
            width={96}
            height={96}
            loading="lazy"
            class="h-16 w-16 shrink-0 object-cover md:h-20 md:w-20"
          />
        )
      }
      <div class="flex flex-col gap-1">
        <span class="text-xs uppercase tracking-widest text-wood md:text-sm">
          {type}
        </span>
        <h3 class="font-serif text-2xl font-light text-ink transition-colors duration-300 group-hover:text-wood md:text-3xl">
          {title}
        </h3>
      </div>
    </div>
    <span
      class="activity-chevron flex h-8 w-8 shrink-0 items-center justify-center border border-line text-lg text-ink transition-[color,border-color] duration-300 group-hover:border-wood group-hover:text-wood"
      aria-hidden="true"
    >
      +
    </span>
  </summary>
  <div class="mt-4 flex flex-col gap-4">
    {
      meta.length > 0 && (
        <div class="flex flex-wrap gap-x-6 gap-y-2 text-xs uppercase tracking-widest text-muted md:text-sm">
          {meta.map((item) => (
            <span>
              <span class="text-ink">{item.value}</span> · {item.label}
            </span>
          ))}
        </div>
      )
    }
    <p class="text-sm text-muted tracking-wide leading-7 md:text-base">
      {description}
    </p>
  </div>
</details>

<style>
  details[open] .activity-chevron {
    transform: rotate(45deg);
  }
</style>
