---
interface Props {
  title: string;
  dates: string;
  description: string;
}

const { title, dates, description } = Astro.props;
---

<article class="flex flex-col gap-2 pt-4 border-t border-t-line">
  <div class="flex flex-row items-center justify-start gap-4">
    <h4 class="text-2xl font-light italic font-serif text-wood md:text-3xl">
      {title}
    </h4>
    <span class="text-sm uppercase tracking-widest text-muted">{dates}</span>
  </div>
  <p class="text-sm text-muted tracking-wide leading-7 md:text-base">
    {description}
  </p>
</article>
