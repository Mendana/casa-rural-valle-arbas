---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLang, useTranslations, normalizePath } from "../../i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const currentYear = new Date().getFullYear();

const currentPath = normalizePath(Astro.url.pathname);
const isActive = (path: string) => currentPath === normalizePath(getRelativeLocaleUrl(lang, path));

const sectionLinks = [
  { path: t("path.home"), label: t("nav.home") },
  { path: t("path.routes"), label: t("pagesSection.1.title") },
  { path: t("path.book"), label: t("pagesSection.2.title") },
  { path: t("path.faq"), label: t("footer.faq.link") },
  { path: t("path.bookingTerms"), label: t("footer.bookingTerms.link") },
].filter((link) => !isActive(link.path));

const legalLinks = [
  { path: t("path.legal"), label: t("footer.legal.link") },
  { path: t("path.privacy"), label: t("footer.privacy.link") },
].filter((link) => !isActive(link.path));
---

<footer class="bg-bg text-ink">
  <div
    class="mx-auto grid max-w-600 grid-cols-1 gap-12 px-4 py-16 md:grid-cols-3 md:px-8"
  >
    <div>
      <h3 class="font-sans text-sm uppercase tracking-widest text-muted">
        {t("footer.contact.title")}
      </h3>
      <div class="mt-4 flex flex-col gap-2 font-sans text-base">
        <a
          href={`tel:${t("footer.contact.phone").replace(/\s/g, "")}`}
          class="transition-colors hover:text-wood focus-visible:text-wood"
        >
          {t("footer.contact.phone")}
        </a>
        <a
          href={`mailto:${t("footer.contact.email")}`}
          class="transition-colors hover:text-wood focus-visible:text-wood"
        >
          {t("footer.contact.email")}
        </a>
        <a
          href={`https://wa.me/${t("footer.contact.phone").replace(/\D/g, "")}`}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-wood focus-visible:text-wood"
        >
          {t("footer.contact.whatsapp")}
        </a>
      </div>
    </div>

    <div>
      <h3 class="font-sans text-sm uppercase tracking-widest text-muted">
        {t("footer.location.title")}
      </h3>
      <div class="mt-4 flex flex-col gap-2 font-sans text-base">
        <span>{t("footer.location.street")}</span>
        <span>{t("footer.location.cityLine")}</span>
      </div>
    </div>

    <div>
      <h3 class="font-sans text-sm uppercase tracking-widest text-muted">
        {t("footer.sections.title")}
      </h3>
      <div class="mt-4 flex flex-col gap-2 font-sans text-base">
        {
          sectionLinks.map((link) => (
            <a
              href={getRelativeLocaleUrl(lang, link.path)}
              class="transition-colors hover:text-wood focus-visible:text-wood"
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-600 px-4 md:px-8">
    <div class="border-t border-line"></div>
  </div>

  <div
    class="mx-auto flex max-w-600 flex-col gap-2 px-4 py-6 font-sans text-sm text-muted sm:flex-row sm:items-center sm:justify-between md:px-8"
  >
    <span>&copy; {currentYear} {t("footer.copyright")}</span>
    <div class="flex flex-col gap-2 sm:flex-row sm:gap-4">
      {
        legalLinks.map((link) => (
          <a
            href={getRelativeLocaleUrl(lang, link.path)}
            class="transition-colors hover:text-wood focus-visible:text-wood"
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</footer>
