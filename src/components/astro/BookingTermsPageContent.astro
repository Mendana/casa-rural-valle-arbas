---
import { getLang, useTranslations } from "../../i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<main id="main-content">
  <section class="mx-auto max-w-600 px-4 py-12 md:px-8 md:py-16">
    <p class="font-sans text-sm text-muted uppercase tracking-[0.2em]">
      {t("bookingTerms.suptitle")}
    </p>
    <h1 class="font-serif text-5xl font-light text-ink mt-6 md:text-6xl">
      {t("bookingTerms.title")}
    </h1>
    <p class="mt-6 max-w-3xl font-serif text-lg font-light leading-8 text-ink md:text-xl">
      {t("bookingTerms.intro")}
    </p>

    <div class="mt-12 flex flex-col gap-10 border-t border-t-line pt-10">
      <article>
        <h2 class="font-serif text-2xl font-light text-ink md:text-3xl">
          {t("bookingTerms.section.1.title")}
        </h2>
        <p class="mt-4 whitespace-pre-line text-base text-muted leading-7 md:text-lg">
          {t("bookingTerms.section.1.body")}
        </p>
      </article>

      <article>
        <h2 class="font-serif text-2xl font-light text-ink md:text-3xl">
          {t("bookingTerms.section.2.title")}
        </h2>
        <p class="mt-4 whitespace-pre-line text-base text-muted leading-7 md:text-lg">
          {t("bookingTerms.section.2.body")}
        </p>
      </article>

      <article>
        <h2 class="font-serif text-2xl font-light text-ink md:text-3xl">
          {t("bookingTerms.section.3.title")}
        </h2>
        <p class="mt-4 whitespace-pre-line text-base text-muted leading-7 md:text-lg">
          {t("bookingTerms.section.3.body")}
        </p>
      </article>

      <article>
        <h2 class="font-serif text-2xl font-light text-ink md:text-3xl">
          {t("bookingTerms.section.4.title")}
        </h2>
        <p class="mt-4 whitespace-pre-line text-base text-muted leading-7 md:text-lg">
          {t("bookingTerms.section.4.body")}
        </p>
      </article>

      <article>
        <h2 class="font-serif text-2xl font-light text-ink md:text-3xl">
          {t("bookingTerms.section.5.title")}
        </h2>
        <p class="mt-4 whitespace-pre-line text-base text-muted leading-7 md:text-lg">
          {t("bookingTerms.section.5.body")}
        </p>
      </article>

      <article>
        <h2 class="font-serif text-2xl font-light text-ink md:text-3xl">
          {t("bookingTerms.section.6.title")}
        </h2>
        <p class="mt-4 whitespace-pre-line text-base text-muted leading-7 md:text-lg">
          {t("bookingTerms.section.6.body")}
        </p>
      </article>

      <article>
        <h2 class="font-serif text-2xl font-light text-ink md:text-3xl">
          {t("bookingTerms.section.7.title")}
        </h2>
        <p class="mt-4 whitespace-pre-line text-base text-muted leading-7 md:text-lg">
          {t("bookingTerms.section.7.body")}
        </p>
      </article>
    </div>

    <p class="mt-12 border-t border-t-line pt-6 font-sans text-sm text-muted/70 italic">
      {t("bookingTerms.placeholderNotice")}
    </p>
  </section>
</main>
