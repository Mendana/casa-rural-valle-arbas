---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { getLang, useTranslations } from "../../i18n/utils";
import PriceBadge from "./PriceBadge.astro";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const slides = (await getCollection("heroGallery"))
  .filter((entry) => entry.id.startsWith(`${lang}/`))
  .sort((a, b) => a.data.order - b.data.order);

const initialIndex = Math.min(1, slides.length - 1);
const count = slides.length;

// Debe coincidir con las constantes del bloque de script más abajo: son el
// mismo cálculo hecho en el servidor para que la primera pintura ya salga
// colocada (si no, se ve un salto cuando el script coge el control).
const SPREAD = 62;
const SCALE_STEP = 0.16;
const MIN_SCALE = 0.62;
const OPACITY_STEP = 0.32;

// Distancia circular: en modo ciclo la vecina más cercana a un índice puede
// estar "al final" de la lista, no solo delante o detrás en orden literal.
function circularDistance(i: number, active: number) {
  if (count === 0) return 0;
  let d = (((i - active) % count) + count) % count;
  if (d > count / 2) d -= count;
  return d;
}

function slideStyle(distance: number) {
  const abs = Math.abs(distance);
  const scale = Math.max(MIN_SCALE, 1 - abs * SCALE_STEP);
  const opacity = abs > 2 ? 0 : Math.max(0, 1 - abs * OPACITY_STEP);
  const z = 10 - abs;
  const pointerEvents = abs > 2 ? "none" : "auto";
  return `transform:translateX(${distance * SPREAD}%) scale(${scale});opacity:${opacity};z-index:${z};pointer-events:${pointerEvents}`;
}
---

<div
  id="hero-carousel"
  data-reveal
  data-active={initialIndex}
  class="relative mx-auto h-100 max-w-320 sm:h-115 md:h-150 lg:h-165 2xl:h-180"
>
  <div id="hero-track" class="relative h-full w-full overflow-hidden">
    {
      slides.map((slide, i) => (
        <figure
          class="hero-slide absolute top-0 left-1/2 h-full w-88 -ml-44 sm:w-104 sm:-ml-52 md:w-136 md:-ml-68 lg:w-160 lg:-ml-80 2xl:w-176 2xl:-ml-88 transition-[transform,opacity] duration-500 ease-out"
          data-index={i}
          style={slideStyle(circularDistance(i, initialIndex))}
        >
          <button
            type="button"
            class="hero-slide-btn block h-full w-full cursor-pointer overflow-hidden rounded-sm"
            aria-label={slide.data.alt}
            aria-current={i === initialIndex ? "true" : "false"}
            tabindex={i === initialIndex ? 0 : -1}
          >
            <Image
              src={slide.data.image}
              alt={slide.data.alt}
              width={860}
              height={1100}
              loading={i === initialIndex ? "eager" : "lazy"}
              class:list={[
                "h-full w-full object-cover",
                i === initialIndex && "hero-breathe",
              ]}
            />
            <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/2 bg-linear-to-t from-black via-black/30 via-30% to-transparent" />
            {slide.data.caption && (
              <figcaption class="absolute inset-x-0 bottom-2 text-center font-sans text-line text-sm tracking-[0.18em] text-shadow-sm uppercase md:text-base md:tracking-[0.2em]">
                {slide.data.caption}
              </figcaption>
            )}
          </button>
        </figure>
      ))
    }

    <div
      class="pointer-events-none absolute top-0 left-1/2 h-full w-88 -ml-44 sm:w-104 sm:-ml-52 md:w-136 md:-ml-68 lg:w-160 lg:-ml-80 2xl:w-176 2xl:-ml-88"
    >
      <PriceBadge subtitle={t("index.photos.card.subtitle")} />
    </div>
  </div>

  {
    slides.length > 1 && (
      <>
        <button
          id="hero-prev"
          type="button"
          aria-label={t("index.photos.prev.alt")}
          class="absolute left-2 top-1/2 z-20 flex h-10 w-10 -translate-y-1/2 cursor-pointer items-center justify-center border border-line bg-bg text-lg text-ink transition-colors hover:border-wood hover:text-wood focus-visible:border-wood focus-visible:text-wood md:left-4 md:h-12 md:w-12 md:text-xl"
        >
          ‹
        </button>
        <button
          id="hero-next"
          type="button"
          aria-label={t("index.photos.next.alt")}
          class="absolute right-2 top-1/2 z-20 flex h-10 w-10 -translate-y-1/2 cursor-pointer items-center justify-center border border-line bg-bg text-lg text-ink transition-colors hover:border-wood hover:text-wood focus-visible:border-wood focus-visible:text-wood md:right-4 md:h-12 md:w-12 md:text-xl"
        >
          ›
        </button>
      </>
    )
  }
</div>

<script>
  const SPREAD = 62;
  const SCALE_STEP = 0.16;
  const MIN_SCALE = 0.62;
  const OPACITY_STEP = 0.32;

  document.querySelectorAll<HTMLElement>("#hero-carousel").forEach((stage) => {
    const slides = Array.from(
      stage.querySelectorAll<HTMLElement>(".hero-slide"),
    );
    const prevBtn = stage.querySelector<HTMLButtonElement>("#hero-prev");
    const nextBtn = stage.querySelector<HTMLButtonElement>("#hero-next");
    let active = Number(stage.dataset.active ?? 0);

    const count = slides.length;

    function circularDistance(i: number, active: number) {
      let d = (((i - active) % count) + count) % count;
      if (d > count / 2) d -= count;
      return d;
    }

    function render() {
      slides.forEach((slide, i) => {
        const btn = slide.querySelector("button");
        const distance = circularDistance(i, active);
        const abs = Math.abs(distance);
        const scale = Math.max(MIN_SCALE, 1 - abs * SCALE_STEP);
        const opacity = abs > 2 ? 0 : Math.max(0, 1 - abs * OPACITY_STEP);
        slide.style.transform = `translateX(${distance * SPREAD}%) scale(${scale})`;
        slide.style.opacity = String(opacity);
        slide.style.zIndex = String(10 - abs);
        slide.style.pointerEvents = abs > 2 ? "none" : "auto";
        btn?.setAttribute("tabindex", i === active ? "0" : "-1");
        btn?.setAttribute("aria-current", i === active ? "true" : "false");
      });
    }

    function goTo(index: number) {
      active = ((index % count) + count) % count;
      stage.dataset.active = String(active);
      render();
    }

    slides.forEach((slide, i) => {
      slide.querySelector("button")?.addEventListener("click", () => {
        if (i !== active) goTo(i);
      });
    });

    prevBtn?.addEventListener("click", () => goTo(active - 1));
    nextBtn?.addEventListener("click", () => goTo(active + 1));

    stage.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") goTo(active - 1);
      if (e.key === "ArrowRight") goTo(active + 1);
    });

    let startX = 0;
    let dragging = false;
    stage.addEventListener("pointerdown", (e) => {
      dragging = true;
      startX = e.clientX;
    });
    stage.addEventListener("pointerup", (e) => {
      if (!dragging) return;
      dragging = false;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 40) goTo(active + (dx < 0 ? 1 : -1));
    });

    render();
  });
</script>
