---
import { getLang, useTranslations } from "../../i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section
  id="contacto"
  data-reveal
  class="mx-auto max-w-600 px-4 py-16 text-center border-b border-b-line md:px-8 md:py-24"
>
  <h2 class="font-serif text-4xl font-light text-ink md:text-5xl">
    {t("book.contact.title")}
  </h2>
  <p class="mt-4 text-base text-muted md:text-lg">
    {t("book.contact.description")}
  </p>
  <div
    class="mt-8 flex flex-col items-center gap-4 md:flex-row md:justify-center md:gap-12"
  >
    <a
      href={`tel:${t("footer.contact.phone").replace(/\s/g, "")}`}
      class="font-serif text-2xl italic text-wood transition-colors hover:text-wood/80 focus-visible:text-wood/80 md:text-3xl"
    >
      {t("footer.contact.phone")}
    </a>
    <a
      href={`mailto:${t("footer.contact.email")}`}
      class="font-serif text-2xl italic text-wood transition-colors hover:text-wood/80 focus-visible:text-wood/80 md:text-3xl"
    >
      {t("footer.contact.email")}
    </a>
  </div>
</section>
