# Google Calendar API key (Google Cloud Console > Credentials).
# Restringida por HTTP referrer al dominio de GitHub Pages, y por API a "Google Calendar API".
PUBLIC_GOOGLE_CALENDAR_KEY=

# ID del calendario público de Google (Ajustes del calendario > Integrar calendario > ID de calendario).
# No es un dato sensible, pero se deja como variable para poder cambiarlo sin tocar código.
PUBLIC_GOOGLE_CALENDAR_ID=

# Precio fijo por noche (número, sin símbolo de moneda) usado por el simulador de reserva.
PUBLIC_PRICE_PER_NIGHT=

# Tarifa fija de limpieza final (número, opcional: si se deja vacía no aparece esa línea).
PUBLIC_CLEANING_FEE=

# Precio por kg de leña (opcional, número; si se deja vacía no aparece esa línea).
PUBLIC_WOOD_PRICE_PER_KG=
